      "updated": 1758247990190,
      "link": null,
      "locked": false,
      "text": "Invoice\n\n/invoice\n/invoice-create\n/invoice/products/:invoiceID\n\nGET /api/invoices → সব invoice list\n\nPOST /api/invoices → invoice create\n\nGET /api/invoices/:invoiceID → নির্দিষ্ট invoice details\n\nGET /api/invoices/:invoiceID/products → নির্দিষ্ট invoice এর\nproducts list",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "gWTXwohV1QFziPj6Ujoyo",
      "originalText": "Invoice\n\n/invoice\n/invoice-create\n/invoice/products/:invoiceID\n\nGET /api/invoices → সব invoice list\n\nPOST /api/invoices → invoice create\n\nGET /api/invoices/:invoiceID → নির্দিষ্ট invoice details\n\nGET /api/invoices/:invoiceID/products → নির্দিষ্ট invoice এর products list",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "T1_k5UakbB1VhhZlVb3Sn",
      "type": "rectangle",
      "x": 181.84523809523864,
      "y": 5983.16382925851,
      "width": 1023.3333333333336,
      "height": 1990,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
